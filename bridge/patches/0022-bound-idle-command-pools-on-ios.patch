+    /// Return an idle pool and release storage past the iOS limits. The result says whether
+    /// this pool was retained; driver destruction runs after releasing the spares mutex.
+    fn retain_command_pool(&self, device: &DeviceShared, pool: CommandPool) -> bool {
+        let retained;
+        let past = {
+            let mut pools = lock(&self.command_pools);
+            let buffers =
+                pool.made.iter().map(Vec::len).sum::<usize>() + usize::from(pool.begun.is_some());
+            if cfg!(target_os = "ios") && buffers > COMMAND_BUFFERS_PER_POOL {
+                retained = false;
+                Some(pool.raw)
+            } else {
+                let past = if cfg!(target_os = "ios")
+                    && pools
+                        .iter()
+                        .filter(|spare| spare.family == pool.family)
+                        .count()
+                        >= COMMAND_POOLS_PER_FAMILY
+                {
+                    let oldest = pools
+                        .iter()
+                        .position(|spare| spare.family == pool.family)
+                        .expect("the full family has an idle pool");
+                    Some(pools.remove(oldest).raw)
+                } else {
+                    None
+                };
+                keep_command_pool(&mut pools, pool);
+                retained = true;
+                past
+            }
+        };
+
+        if let Some(raw) = past {
+            // SAFETY: the returned pool or an idle spare is exclusively held and has no pending work.
+            unsafe { release_in_section(device, raw) };
+        }
+
+        retained
+    }
