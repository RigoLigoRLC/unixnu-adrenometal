@@ -0,0 +1,248 @@
+//! Extended-range cube samples read decoded texels from the cube's 2D-array view.
+//!
+//! The face routines select the face and its texel position. The cube fold maps taps across
+//! edges into adjacent faces. At a corner, the decoded values of the three faces contribute
+//! weights 6, 5 and 5 out of 16; the bilinear sum also operates on decoded floats. The sampler
+//! planner records `PrecisionNote::ExtendedRangeSampling` for this arithmetic. Nearest samples
+//! retain the format decoder's rounding, and gathers swizzle each tap before taking its channel.
+
+use crate::lower::emit::EmitCx;
+use crate::spirv::builder::FunctionBuilder;
+use crate::spirv::error::BResult;
+use crate::spirv::ids::Value as SValue;
+use crate::spirv::ir::{BinOp, ConvOp, GlslOp, ImageOperands, ImageQuery, Type};
+
+use super::bicubic::{self, Addressing, Tys, quantize, scalar, value};
+use super::extended::{self, At, Decode, Texture};
+use super::face::{self, FaceWrap, Wraps};
+
+/// The sample reads one mip of a cube or cube array through its raw integer face view.
+/// Its caller selects the mip and applies the final swizzle to ordinary samples; gathers
+/// select their channel here after swizzling each decoded tap.
+pub(super) fn sample(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    at: &At<'_>,
+    tex: &Texture,
+    addressing: Addressing<'_>,
+    linear: bool,
+    gather: Option<u32>,
+) -> BResult<SValue> {
+    let Some(routines) = tex.cube else {
+        return Err(cx.fail("an extended-range cube sample without its face routines"));
+    };
+    let routines = routines.declared(cx)?;
+    let wrap = match addressing {
+        Addressing::Modes { address, .. } => Wraps::Axes(FaceWrap::of(
+            address.first().copied(),
+            address.get(1).copied(),
+        )),
+        Addressing::Word { word, .. } => Wraps::Word(word),
+    };
+    let zero = unsigned(fb, t, 0)?;
+    let one = unsigned(fb, t, 1)?;
+    let six = unsigned(fb, t, 6)?;
+    let level = match gather {
+        Some(_) => zero,
+        None => at.level.unwrap_or(zero),
+    };
+    let size = fb.query(ImageQuery::SizeLod(level), tex.img)?;
+    let n = fb.composite_extract(size, &[0])?;
+    let base = match at.layer {
+        Some(index) => {
+            let layers = fb.composite_extract(size, &[2])?;
+            let cubes = fb.binary(BinOp::UDiv, layers, six)?;
+            let last = fb.binary(BinOp::ISub, cubes, one)?;
+            let index = fb.convert(ConvOp::Bitcast, index, t.u32_)?;
+            let index = fb.glsl(GlslOp::UMin, &[index, last])?;
+            fb.binary(BinOp::IMul, index, six)?
+        }
+        None => zero,
+    };
+    let direction = face::metal_ties(fb, at.coord)?;
+    let position = face::position(fb, direction, n, (routines, wrap))?;
+    let lod = ImageOperands {
+        lod: Some(level),
+        ..ImageOperands::default()
+    };
+
+    if !linear && gather.is_none() {
+        let nf = fb.convert(ConvOp::ConvertUToF, n, t.f32_)?;
+        let first = floating(fb, t, 0.0)?;
+        let unit = floating(fb, t, 1.0)?;
+        let last = fb.binary(BinOp::FSub, nf, unit)?;
+        let nearest = |fb: &mut FunctionBuilder<'_>, p: SValue| -> BResult<SValue> {
+            let p = fb.glsl(GlslOp::Floor, &[p])?;
+            let p = fb.glsl(GlslOp::NClamp, &[p, first, last])?;
+            fb.convert(ConvOp::ConvertFToU, p, t.u32_)
+        };
+        let x = nearest(fb, position.s)?;
+        let y = nearest(fb, position.t)?;
+        let layer = fb.binary(BinOp::IAdd, base, position.face)?;
+        let coord_ty = fb.module().ty(Type::Vector {
+            elem: t.u32_,
+            len: 3,
+        })?;
+        let coord = fb.composite_construct(coord_ty, &[x, y, layer])?;
+        let raw = fb.fetch(tex.img, coord, &lod)?;
+        return nearest_value(cx, fb, tex, raw, at.half);
+    }
+
+    let Some(cube) = cx.decl.families.sampler.linear_cube else {
+        return Err(cx.fail("an extended-range cube sample without its face fold"));
+    };
+    let (i, kx) = quantize(fb, t, position.s, None)?;
+    let (j, ky) = quantize(fb, t, position.t, None)?;
+    let i32_ = fb.module().ty(Type::Int {
+        width: 32,
+        signed: true,
+    })?;
+    let ni = fb.convert(ConvOp::Bitcast, n, i32_)?;
+    let one_i = scalar(fb, i32_, 1)?;
+    let one_i = value(fb, one_i)?;
+    let zero_i = scalar(fb, i32_, 0)?;
+    let zero_i = value(fb, zero_i)?;
+    let i1 = fb.binary(BinOp::IAdd, i, one_i)?;
+    let j1 = fb.binary(BinOp::IAdd, j, one_i)?;
+    let fetch = |fb: &mut FunctionBuilder<'_>, x: SValue, y: SValue, pick: u32| {
+        let pick = unsigned(fb, t, pick)?;
+        let coord = fb
+            .call(cube.fold, &[position.face, x, y, ni, pick, base])?
+            .ok_or_else(bicubic::missing_routine)?;
+        fb.fetch(tex.img, coord, &lod)
+    };
+    let raw = [
+        fetch(fb, i, j, 0)?,
+        fetch(fb, i1, j, 0)?,
+        fetch(fb, i, j1, 0)?,
+        fetch(fb, i1, j1, 0)?,
+    ];
+    let mut taps = Vec::with_capacity(4);
+    for raw in raw {
+        taps.push(extended::decoded(cx, fb, tex, raw, false)?);
+    }
+
+    // The candidate past both edges reads three faces at the same cube corner.
+    let low_i = fb.binary(BinOp::SLessThan, i, zero_i)?;
+    let low_j = fb.binary(BinOp::SLessThan, j, zero_i)?;
+    let past_i = fb.binary(BinOp::SGreaterThanEqual, i1, ni)?;
+    let past_j = fb.binary(BinOp::SGreaterThanEqual, j1, ni)?;
+    let past_i = fb.binary(BinOp::LogicalOr, low_i, past_i)?;
+    let past_j = fb.binary(BinOp::LogicalOr, low_j, past_j)?;
+    let corner = fb.binary(BinOp::LogicalAnd, past_i, past_j)?;
+    let ci = fb.select(low_i, i, i1)?;
+    let cj = fb.select(low_j, j, j1)?;
+    let row0 = fb.select(low_i, taps[0], taps[1])?;
+    let row1 = fb.select(low_i, taps[2], taps[3])?;
+    let x = fb.select(low_j, row0, row1)?;
+    let y = fetch(fb, ci, cj, 1)?;
+    let y = extended::decoded(cx, fb, tex, y, false)?;
+    let z = fetch(fb, ci, cj, 2)?;
+    let z = extended::decoded(cx, fb, tex, z, false)?;
+    let made = corner_value(fb, t, tex, [x, y, z])?;
+    let mut corners = Vec::with_capacity(4);
+    for (ti, tj) in [(i, j), (i1, j), (i, j1), (i1, j1)] {
+        let on_i = fb.binary(BinOp::IEqual, ti, ci)?;
+        let on_j = fb.binary(BinOp::IEqual, tj, cj)?;
+        let here = fb.binary(BinOp::LogicalAnd, on_i, on_j)?;
+        corners.push(fb.binary(BinOp::LogicalAnd, corner, here)?);
+    }
+
+    if let Some(component) = gather {
+        let made = extended::rounded(fb, made, at.half)?;
+        let mut lanes = Vec::with_capacity(4);
+        for index in [2, 3, 1, 0] {
+            let tap = match at.half {
+                true => extended::decoded(cx, fb, tex, raw[index], true)?,
+                false => taps[index],
+            };
+            let tap = fb.select(corners[index], made, tap)?;
+            let tap = extended::swizzled(fb, tex, tap)?;
+            lanes.push(fb.composite_extract(tap, &[component])?);
+        }
+        return fb.composite_construct(t.vec4, &lanes);
+    }
+
+    for (tap, here) in taps.iter_mut().zip(corners) {
+        *tap = fb.select(here, made, *tap)?;
+    }
+    let kx = fraction(fb, t, kx)?;
+    let ky = fraction(fb, t, ky)?;
+    let row0 = blend(fb, taps[0], taps[1], kx)?;
+    let row1 = blend(fb, taps[2], taps[3], kx)?;
+    let result = blend(fb, row0, row1, ky)?;
+    extended::rounded(fb, result, at.half)
+}
+
+fn nearest_value(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    tex: &Texture,
+    raw: SValue,
+    half: bool,
+) -> BResult<SValue> {
+    match (half, tex.decode) {
+        (true, Decode::Form { form, .. }) if form.bfloat() => {
+            let v = extended::decoded(cx, fb, tex, raw, false)?;
+            crate::lower::arith::extended_range::bfloat_sample_half(fb, v)
+        }
+        (true, Decode::Heap { bfloat, .. }) => {
+            let v = extended::decoded(cx, fb, tex, raw, false)?;
+            let toward = crate::lower::arith::extended_range::bfloat_sample_half(fb, v)?;
+            let rounded = extended::decoded(cx, fb, tex, raw, true)?;
+            fb.select(bfloat, toward, rounded)
+        }
+        _ => extended::decoded(cx, fb, tex, raw, half),
+    }
+}
+
+fn corner_value(
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    tex: &Texture,
+    [x, y, z]: [SValue; 3],
+) -> BResult<SValue> {
+    let weight_x = floating(fb, t, 6.0 / 16.0)?;
+    let weight_yz = floating(fb, t, 5.0 / 16.0)?;
+    let weight_x = fb.composite_construct(t.vec4, &[weight_x; 4])?;
+    let weight_yz = fb.composite_construct(t.vec4, &[weight_yz; 4])?;
+    let x_part = fb.binary_no_contraction(BinOp::FMul, x, weight_x)?;
+    let y_part = fb.binary_no_contraction(BinOp::FMul, y, weight_yz)?;
+    let z_part = fb.binary_no_contraction(BinOp::FMul, z, weight_yz)?;
+    let xy = fb.binary_no_contraction(BinOp::FAdd, x_part, y_part)?;
+    let made = fb.binary_no_contraction(BinOp::FAdd, xy, z_part)?;
+    match tex.decode {
+        Decode::Form { form, .. } if form.bfloat() => Ok(x),
+        Decode::Heap { bfloat, .. } => fb.select(bfloat, x, made),
+        _ => Ok(made),
+    }
+}
+
+fn fraction(fb: &mut FunctionBuilder<'_>, t: &Tys, steps: SValue) -> BResult<SValue> {
+    let steps = fb.convert(ConvOp::ConvertUToF, steps, t.f32_)?;
+    let scale = floating(fb, t, 1.0 / 256.0)?;
+    let weight = fb.binary_no_contraction(BinOp::FMul, steps, scale)?;
+    fb.composite_construct(t.vec4, &[weight; 4])
+}
+
+fn blend(
+    fb: &mut FunctionBuilder<'_>,
+    a: SValue,
+    b: SValue,
+    weight: SValue,
+) -> BResult<SValue> {
+    let delta = fb.binary_no_contraction(BinOp::FSub, b, a)?;
+    let part = fb.binary_no_contraction(BinOp::FMul, delta, weight)?;
+    fb.binary_no_contraction(BinOp::FAdd, a, part)
+}
+
+fn unsigned(fb: &mut FunctionBuilder<'_>, t: &Tys, x: u32) -> BResult<SValue> {
+    let c = scalar(fb, t.u32_, u64::from(x))?;
+    value(fb, c)
+}
+
+fn floating(fb: &mut FunctionBuilder<'_>, t: &Tys, x: f32) -> BResult<SValue> {
+    let c = scalar(fb, t.f32_, u64::from(x.to_bits()))?;
+    value(fb, c)
+}
