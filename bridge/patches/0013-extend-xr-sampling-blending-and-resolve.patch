+/// A filtered float texel rounded once to the requested result width.
+pub(super) fn rounded(fb: &mut FunctionBuilder<'_>, x: SValue, half: bool) -> BResult<SValue> {
+    if !half {
+        return Ok(x);
+    }
+    use crate::lower::arith::legal::{FloatFmt, Form, Held};
+    use crate::lower::arith::texel_round::{f32_to_half, HalfRounding};
+    f32_to_half(
+        fb,
+        Form {
+            held: Held::Float(FloatFmt::F32),
+            lanes: 4,
+        },
+        x,
+        HalfRounding::NearestEven,
+    )
+}
