+/// The level calculation consumes gradients already evaluated by the caller. A switch prelude
+/// supplies gradients with its bias applied; direct samples supply their separate bias operand.
+pub(super) fn level_from_gradients(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    (coord, axes, img, cube): (SValue, u8, SValue, bool),
+    (bias, (dx, dy)): (Option<ValueId>, (SValue, SValue)),
+) -> BResult<SValue> {
+    let (dx, dy) = if cube { cube_gradients(fb, t, coord, (dx, dy))? } else { (dx, dy) };
+    let zero = scalar(fb, t.u32_, 0)?;
+    let zero = value(fb, zero)?;
+    let size = fb.query(ImageQuery::SizeLod(zero), img)?;
+    // The plane axes' sizes (a 2D array's layer count left out).
+    let mut scaled = Vec::with_capacity(usize::from(axes));
+    let axes = if cube { 3 } else { axes };
+    for lane in 0..u32::from(axes) {
+        let n = if axes == 1 && fb.value_ty(size)? == t.u32_ { size } else {
+            fb.composite_extract(size, &[if cube { 0 } else { lane }])?
+        };
+        scaled.push(fb.convert(ConvOp::ConvertUToF, n, t.f32_)?);
+    }
+    let vec = if axes == 1 { t.f32_ } else { fb.module().ty(crate::spirv::ir::Type::Vector {
+        elem: t.f32_,
+        len: axes,
+    })? };
+    let size = if axes == 1 { scaled[0] } else { fb.composite_construct(vec, &scaled)? };
+    let gx = fb.binary(BinOp::FMul, dx, size)?;
+    let gy = fb.binary(BinOp::FMul, dy, size)?;
+    let op = if axes == 1 { GlslOp::FAbs } else { GlslOp::Length };
+    let gx = fb.glsl(op, &[gx])?;
+    let gy = fb.glsl(op, &[gy])?;
+    let rho = fb.glsl(GlslOp::FMax, &[gx, gy])?;
+    let lambda = fb.glsl(GlslOp::Log2, &[rho])?;
+    match bias {
+        Some(b) => {
+            let b = cx.operand(fb, b)?;
+            fb.binary(BinOp::FAdd, lambda, b)
+        }
+        None => Ok(lambda),
+    }
+}
