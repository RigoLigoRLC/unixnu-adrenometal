+/// The anisotropic wrapper keeps one isotropic sample when the bound degree is one. Other
+/// degrees evaluate a bounded set of positions along the footprint's major axis.
+fn anisotropic(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    e: &Sample,
+    degree: Anisotropy,
+    (coord, layer, level): (SValue, Option<SValue>, Option<SValue>),
+    passed: Option<(SValue, u8)>,
+    grads: Option<(SValue, SValue)>,
+) -> BResult<SValue> {
+    let t = Tys::new(fb)?;
+    let gradients = match e.filter_level {
+        LevelAt::Derived { grad: Some((x, y)), .. } => (cx.operand(fb, x)?, cx.operand(fb, y)?),
+        LevelAt::Derived { grad: None, .. } => (
+            fb.derivative(crate::spirv::ir::DerivOp::DPdx, coord)?,
+            fb.derivative(crate::spirv::ir::DerivOp::DPdy, coord)?,
+        ),
+        LevelAt::Hoisted => grads
+            .ok_or_else(|| cx.fail("an XR switch sample without its prelude gradients"))?,
+        _ => return Err(cx.fail("an XR anisotropic sample without gradients")),
+    };
+    let la = match degree {
+        Anisotropy::Const(n) => {
+            let c = scalar(fb, t.u32_, u64::from(n.min(4)))?;
+            value(fb, c)?
+        }
+        Anisotropy::Slot(n) => {
+            let Some(la) = cx.decl.families.sampler.degrees.get(&n).copied() else {
+                return Err(cx.fail("an XR sampler without its anisotropy degree"));
+            };
+            let cap = scalar(fb, t.u32_, 4)?;
+            let cap = value(fb, cap)?;
+            fb.glsl(GlslOp::UMin, &[la, cap])?
+        }
+        Anisotropy::Heap(handle) => {
+            let la = super::heap_metadata::read(cx, fb, handle)?.anisotropy;
+            let cap = scalar(fb, t.u32_, 4)?;
+            let cap = value(fb, cap)?;
+            fb.glsl(GlslOp::UMin, &[la, cap])?
+        }
+    };
+    let zero = scalar(fb, t.u32_, 0)?;
+    let zero = value(fb, zero)?;
+    let enabled = fb.binary(BinOp::INotEqual, la, zero)?;
+    let r = Extended::of(e);
+    let yes: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = anisotropic_taps(cx, fb, e, la, (coord, layer, level), gradients, passed)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let no: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = sampled(cx, fb, &r, (coord, layer, level), (e.offset.as_deref(), passed), level)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let Merged(values) = fb.if_(cx, enabled, yes, Some(no))?;
+    match values[..] {
+        [x] => Ok(x),
+        _ => Err(cx.fail("an XR anisotropic branch without its texel")),
+    }
+}
