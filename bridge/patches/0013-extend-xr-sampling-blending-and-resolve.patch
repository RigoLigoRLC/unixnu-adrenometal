+fn anisotropic(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    raw: &HeapRaw,
+    at: &At<'_>,
+    tex: &Texture,
+    bfloat: SValue,
+    degree: Anisotropy,
+    gradients: (SValue, SValue, Option<SValue>),
+    level: SValue,
+) -> BResult<SValue> {
+    let la = match degree {
+        Anisotropy::Const(n) => unsigned(fb, t, n.min(4))?,
+        Anisotropy::Slot(n) => match cx.decl.families.sampler.degrees.get(&n).copied() {
+            Some(degree) => degree,
+            None => return Err(cx.fail("a raw heap sampler without its anisotropy degree")),
+        },
+        Anisotropy::Heap(handle) => super::heap_metadata::read(cx, fb, handle)?.anisotropy,
+    };
+    let cap = unsigned(fb, t, 4)?;
+    let la = fb.glsl(GlslOp::UMin, &[la, cap])?;
+    let zero = unsigned(fb, t, 0)?;
+    let enabled = fb.binary(BinOp::INotEqual, la, zero)?;
+    let yes: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = anisotropic_taps(cx, fb, t, raw, at, tex, bfloat, la, gradients)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let no: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = sample_levels(cx, fb, t, raw, at, tex, bfloat, level)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let Merged(values) = fb.if_(cx, enabled, yes, Some(no))?;
+    match values[..] {
+        [x] => Ok(x),
+        _ => Err(cx.fail("a raw heap anisotropic branch without its texel")),
+    }
+}
