+pub(super) fn state_word(cx: &mut EmitCx<'_>, fb: &mut FunctionBuilder<'_>, state: &State) -> BResult<SValue> {
+    match *state {
+        State::Slot { sampler } => super::emit::sampler_word(cx, fb, Pixel::Spec(sampler)),
+        State::Heap { sampler } => Ok(super::heap_metadata::read(cx, fb, sampler)?.word),
+        State::Constant { .. } => Err(cx.fail("a constant sampler requested a runtime word")),
+    }
+}
