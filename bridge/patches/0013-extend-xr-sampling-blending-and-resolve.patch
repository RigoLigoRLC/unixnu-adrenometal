+/// Each level uses the selected minification or magnification filter. Bfloat formats read the
+/// nearest texel under either filter and retain their nearest-sample half conversion.
+fn sample_level(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    raw: &HeapRaw,
+    at: &At<'_>,
+    tex: &Texture,
+    bfloat: SValue,
+) -> BResult<SValue> {
+    let modes = addressing(cx, fb, raw)?;
+    let nearest: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = extended::nearest(cx, fb, t, at, tex, modes)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let filtered: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+        let x = extended::filters(cx, fb, t, at, tex, &raw.state)?;
+        Ok(ArmEnd::FallThrough(vec![x]))
+    });
+    let Merged(values) = fb.if_(cx, bfloat, nearest, Some(filtered))?;
+    match values[..] {
+        [x] => Ok(x),
+        _ => Err(cx.fail("a raw heap filter branch without its texel")),
+    }
+}
