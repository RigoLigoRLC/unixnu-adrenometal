+            state: e.state.clone(),
+            cubic: e.cubic.clone(),
+            gather: e.gather,
+            swizzle: e.swizzle,
+            offset: e.offset.as_ref().map(|o| o.len() as u8),
+            offset_base: e.offset_base,
+            volume: e.volume,
+            plane: e.plane,
+            cube: e.cube,
