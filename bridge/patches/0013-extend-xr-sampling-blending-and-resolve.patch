+/// The mip filter selects one level or blends two decoded samples. A zero blend weight reads
+/// only the first level, keeping an unused level's NaNs out of the result.
+fn sample_levels(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    raw: &HeapRaw,
+    at: &At<'_>,
+    tex: &Texture,
+    bfloat: SValue,
+    level: SValue,
+) -> BResult<SValue> {
+    if let Some(component) = raw.gather {
+        let modes = addressing(cx, fb, raw)?;
+        return extended::gathered(cx, fb, t, at, tex, modes, component);
+    }
+    match extended::levels(cx, fb, t, raw.level.mip(), Some(level), tex)? {
+        None => sample_level(cx, fb, t, raw, at, tex, bfloat),
+        Some(Levels { first, blend: None }) => {
+            let at = At {
+                level: Some(first),
+                ..*at
+            };
+            sample_level(cx, fb, t, raw, &at, tex, bfloat)
+        }
+        Some(Levels {
+            first,
+            blend: Some((second, weight)),
+        }) => {
+            let zero = unsigned(fb, t, 0)?;
+            let blends = fb.binary(BinOp::INotEqual, weight, zero)?;
+            let pair: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+                let first = At {
+                    level: Some(first),
+                    half: false,
+                    ..*at
+                };
+                let second = At {
+                    level: Some(second),
+                    half: false,
+                    ..*at
+                };
+                let a = sample_level(cx, fb, t, raw, &first, tex, bfloat)?;
+                let b = sample_level(cx, fb, t, raw, &second, tex, bfloat)?;
+                let weight = fb.convert(ConvOp::ConvertUToF, weight, t.f32_)?;
+                let scale = floating(fb, t, 1.0 / 64.0)?;
+                let weight = fb.binary_no_contraction(BinOp::FMul, weight, scale)?;
+                let weight = fb.composite_construct(t.vec4, &[weight; 4])?;
+                let difference = fb.binary_no_contraction(BinOp::FSub, b, a)?;
+                let part = fb.binary_no_contraction(BinOp::FMul, difference, weight)?;
+                let x = fb.binary_no_contraction(BinOp::FAdd, a, part)?;
+                let x = extended::rounded(fb, x, at.half)?;
+                Ok(ArmEnd::FallThrough(vec![x]))
+            });
+            let single: ArmFn<'_, EmitCx<'_>> = Box::new(move |fb, cx| {
+                let at = At {
+                    level: Some(first),
+                    ..*at
+                };
+                let x = sample_level(cx, fb, t, raw, &at, tex, bfloat)?;
+                Ok(ArmEnd::FallThrough(vec![x]))
+            });
+            let Merged(values) = fb.if_(cx, blends, pair, Some(single))?;
+            match values[..] {
+                [x] => Ok(x),
+                _ => Err(cx.fail("a raw heap mip blend without its texel")),
+            }
+        }
+    }
+}
