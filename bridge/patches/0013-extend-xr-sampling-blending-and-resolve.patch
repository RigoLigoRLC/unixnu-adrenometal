+/// The cube gradients differentiate each face coordinate's quotient by the major component.
+/// Their three-lane form keeps one zero lane, so lengths and areas can reuse vector arithmetic.
+pub(super) fn cube_gradients(
+    fb: &mut FunctionBuilder<'_>,
+    t: &Tys,
+    p: SValue,
+    (dx, dy): (SValue, SValue),
+) -> BResult<(SValue, SValue)> {
+    let components = [fb.composite_extract(p, &[0])?, fb.composite_extract(p, &[1])?, fb.composite_extract(p, &[2])?];
+    let absolute = fb.glsl(GlslOp::FAbs, &[p])?;
+    let a = [fb.composite_extract(absolute, &[0])?, fb.composite_extract(absolute, &[1])?, fb.composite_extract(absolute, &[2])?];
+    let xy = fb.binary(BinOp::FOrdGreaterThanEqual, a[0], a[1])?;
+    let xz = fb.binary(BinOp::FOrdGreaterThanEqual, a[0], a[2])?;
+    let x = fb.binary(BinOp::LogicalAnd, xy, xz)?;
+    let y = fb.binary(BinOp::FOrdGreaterThanEqual, a[1], a[2])?;
+    let yz = fb.select(y, components[1], components[2])?;
+    let major = fb.select(x, components[0], yz)?;
+    let magnitude = fb.glsl(GlslOp::FAbs, &[major])?;
+    let epsilon = scalar(fb, t.f32_, u64::from(1.0e-20f32.to_bits()))?;
+    let epsilon = value(fb, epsilon)?;
+    let safe = fb.glsl(GlslOp::FMax, &[magnitude, epsilon])?;
+    let sign = fb.glsl(GlslOp::FSign, &[major])?;
+    let denominator = fb.binary(BinOp::FMul, safe, sign)?;
+    let nonzero = fb.binary(BinOp::FOrdGreaterThan, magnitude, epsilon)?;
+    let denominator = fb.select(nonzero, denominator, epsilon)?;
+    let half = scalar(fb, t.f32_, u64::from(0.5f32.to_bits()))?;
+    let half = value(fb, half)?;
+    let scale = fb.binary(BinOp::FDiv, half, safe)?;
+    let vector = fb.value_ty(p)?;
+    let scale = fb.composite_construct(vector, &[scale; 3])?;
+    let project = |fb: &mut FunctionBuilder<'_>, gradient: SValue| -> BResult<SValue> {
+        let gx = fb.composite_extract(gradient, &[0])?;
+        let gy = fb.composite_extract(gradient, &[1])?;
+        let gz = fb.composite_extract(gradient, &[2])?;
+        let yz = fb.select(y, gy, gz)?;
+        let normal = fb.select(x, gx, yz)?;
+        let quotient = fb.binary(BinOp::FDiv, normal, denominator)?;
+        let quotient = fb.composite_construct(vector, &[quotient; 3])?;
+        let normal = fb.binary_no_contraction(BinOp::FMul, p, quotient)?;
+        let tangent = fb.binary_no_contraction(BinOp::FSub, gradient, normal)?;
+        fb.binary_no_contraction(BinOp::FMul, tangent, scale)
+    };
+    Ok((project(fb, dx)?, project(fb, dy)?))
 }
 
