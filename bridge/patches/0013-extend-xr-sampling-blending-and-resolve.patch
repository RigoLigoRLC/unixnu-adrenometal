+    let bias = uvec4_const(f, t, bias)?;
+    let sum = f.binary(BinOp::IAdd, sum, bias)?;
+    let n = codes.len() as u32;
+    let shift = uvec4_const(f, t, [n.trailing_zeros(); 4])?;
