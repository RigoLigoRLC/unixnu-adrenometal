+fn addressing<'a>(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    raw: &'a HeapRaw,
+) -> BResult<Addressing<'a>> {
+    match &raw.state {
+        State::Constant {
+            address,
+            border,
+            pixel,
+            ..
+        } => Ok(Addressing::Modes {
+            address,
+            border: *border,
+            pixel: *pixel,
+        }),
+        State::Slot { .. } | State::Heap { .. } => Ok(Addressing::Word {
+            word: extended::state_word(cx, fb, &raw.state)?,
+            axes: usize::from(raw.plane),
+        }),
+    }
+}
