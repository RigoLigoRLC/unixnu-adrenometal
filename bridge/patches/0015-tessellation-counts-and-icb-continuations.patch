diff --git a/crates/metal2vulkan-runtime/src/render/deferred_shadows.rs b/crates/metal2vulkan-runtime/src/render/deferred_shadows.rs
new file mode 100644
index 0000000..892f088
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/render/deferred_shadows.rs
@@ -0,0 +1,118 @@
+//! Shadow copies for a render pass whose indirect commands resolve resources at commit.
+
+use super::shadows::{self, InstanceShadows};
+use crate::command_buffer::CommandBuffer;
+use crate::device::lock;
+use crate::encoder::{EncoderCore, RecordedSegment};
+use crate::error::{internal, Error};
+use crate::render_pass::PassLayout;
+use crate::shadow::ShadowCopy;
+use std::sync::{Arc, Mutex};
+
+/// DeferredShadows owns the resources each render instance and tile dispatch can access.
+/// At commit it adds the command buffer's final residency to instances containing indirect
+/// commands, then computes the copies before every instance and after all attachment stores.
+/// Separate command-buffer segments keep the first and last copies at those exact positions.
+pub(crate) struct DeferredShadows {
+    instances: Vec<(InstanceShadows, bool)>,
+    dispatches: Vec<(usize, InstanceShadows)>,
+    layout: PassLayout,
+    reached: bool,
+    drawn: Option<([u32; 4], Vec<bool>)>,
+    planned: Mutex<Option<Arc<PlannedShadows>>>,
+}
+
+/// PlannedShadows owns the copy commands and merge buffers for one complete render pass.
+pub(super) struct PlannedShadows {
+    pub(super) instances: Vec<Vec<ShadowCopy>>,
+    pub(super) dispatches: Vec<Vec<ShadowCopy>>,
+    finish: Vec<ShadowCopy>,
+}
+
+impl DeferredShadows {
+    pub(super) fn new(
+        instances: Vec<(InstanceShadows, bool)>,
+        dispatches: Vec<(usize, InstanceShadows)>,
+        layout: PassLayout,
+        reached: bool,
+        drawn: Option<([u32; 4], Vec<bool>)>,
+    ) -> DeferredShadows {
+        DeferredShadows {
+            instances,
+            dispatches,
+            layout,
+            reached,
+            drawn,
+            planned: Mutex::new(None),
+        }
+    }
+
+    pub(super) fn planned(&self) -> Option<Arc<PlannedShadows>> {
+        lock(&self.planned).clone()
+    }
+
+    pub(super) fn ready(&self) -> Result<Arc<PlannedShadows>, Error> {
+        self.planned().ok_or_else(|| internal("render shadow copies were not prepared"))
+    }
+
+    pub(crate) fn record(
+        &self,
+        command_buffer: &CommandBuffer,
+        finish: bool,
+    ) -> Result<RecordedSegment, Error> {
+        let mut core = EncoderCore::segment(command_buffer, false)?;
+        let planned = if finish {
+            self.ready()?
+        } else {
+            let mut held = lock(&self.planned);
+            if let Some(planned) = held.as_ref() {
+                Arc::clone(planned)
+            } else {
+                let residency = command_buffer.residency()?;
+                let mut instances = self.instances.clone();
+                for (instance, executes) in &mut instances {
+                    if *executes {
+                        instance.add_residency(&residency);
+                    }
+                }
+                let mut order = Vec::new();
+                for (index, (instance, _)) in instances.iter().enumerate() {
+                    order.push((instance, false));
+                    for (_, dispatch) in self.dispatches.iter().filter(|(after, _)| *after == index + 1) {
+                        order.push((dispatch, true));
+                    }
+                }
+                let drawn = self.drawn.as_ref().map(|(area, loaded)| (*area, &loaded[..]));
+                let copies = shadows::plan(
+                    &mut core,
+                    order.iter().map(|(instance, _)| *instance),
+                    &self.layout,
+                    (self.reached, drawn),
+                )?;
+                let mut planned = PlannedShadows {
+                    instances: Vec::new(),
+                    dispatches: Vec::new(),
+                    finish: core.finish_shadow_plan(),
+                };
+                for ((_, dispatch), copies) in order.into_iter().zip(copies) {
+                    if dispatch {
+                        planned.dispatches.push(copies);
+                    } else {
+                        planned.instances.push(copies);
+                    }
+                }
+                let planned = Arc::new(planned);
+                *held = Some(Arc::clone(&planned));
+                planned
+            }
+        };
+        let copies = if finish {
+            &planned.finish[..]
+        } else {
+            planned.instances.first().map_or(&[][..], |copies| &copies[..])
+        };
+        core.shadow_copies(copies);
+        core.retain(planned);
+        core.end_segment()
+    }
+}
