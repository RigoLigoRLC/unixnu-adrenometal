diff --git a/crates/metal2vulkan-runtime/src/gpu_trace.rs b/crates/metal2vulkan-runtime/src/gpu_trace.rs
new file mode 100644
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/gpu_trace.rs
@@ -0,0 +1,278 @@
+//! Metal workload metadata sent to the driver's bounded GPU capture buffer.
+//! The driver owns capture control, timestamps, submission links and transport.
+
+use crate::render_pass::{PassLayout, Target};
+use crate::texture::Texture;
+use ash::vk;
+use ash::vk::Handle;
+
+type Enabled = unsafe extern "system" fn(vk::Device) -> vk::Bool32;
+type Record = unsafe extern "system" fn(vk::Device, vk::CommandBuffer, u32, u32, *const u64, u32);
+
+/// Trace holds the optional driver's metadata callbacks for one Vulkan device.
+/// Calls copy at most four words into the driver's bounded buffer while capture
+/// is enabled. The driver owns timestamping, capture capacity and transport.
+#[derive(Clone, Copy)]
+pub(crate) struct Trace {
+    device: vk::Device,
+    enabled: Option<Enabled>,
+    record: Option<Record>,
+}
+
+impl Trace {
+    /// The callbacks returned by the live device's loader, when present.
+    pub(crate) unsafe fn load(instance: &ash::Instance, device: vk::Device) -> Self {
+        // SAFETY: these private entry points have the signatures declared above.
+        let (enabled, record) = unsafe {
+            (
+                instance.get_device_proc_addr(device, c"vkNativeAdrenoTraceEnabled".as_ptr()),
+                instance.get_device_proc_addr(device, c"vkNativeAdrenoTraceMetal".as_ptr()),
+            )
+        };
+
+        Self {
+            device,
+            // SAFETY: the driver exports the exact signatures declared above.
+            enabled: enabled.map(|function| unsafe { std::mem::transmute(function) }),
+            record: record.map(|function| unsafe { std::mem::transmute(function) }),
+        }
+    }
+
+    /// The active capture generation, or zero while metadata admission is closed.
+    pub(crate) fn generation(self) -> u32 {
+        match (self.enabled, self.record) {
+            // SAFETY: the device owns these callbacks throughout each recording.
+            (Some(enabled), Some(_)) => unsafe { enabled(self.device) },
+            _ => 0,
+        }
+    }
+
+    pub(crate) fn enabled(self) -> bool {
+        self.generation() != 0
+    }
+
+    fn emit(self, raw: vk::CommandBuffer, point: u32, flags: u32, words: [u64; 4]) {
+        if !self.enabled() {
+            return;
+        }
+
+        if let Some(record) = self.record {
+            // SAFETY: the driver copies the words before returning. A null
+            // command buffer denotes metadata associated by the encoder ID.
+            unsafe { record(self.device, raw, point, flags, words.as_ptr(), 4) };
+        }
+    }
+}
+
+/// Work names a Metal command buffer, encoder and pipeline while Vulkan commands
+/// are recorded. Deferred draws retain these numbers with their recording data.
+#[derive(Clone, Copy)]
+pub(crate) struct Work {
+    pub(crate) trace: Trace,
+    pub(crate) command_buffer: u64,
+    pub(crate) encoder: u64,
+    pub(crate) queue: u64,
+    pub(crate) pipeline: u64,
+}
+
+/// RecordedMetadata contains the Metal identities already emitted for one Vulkan
+/// command buffer during a capture. Bound resets it when its command buffer changes.
+#[derive(Default)]
+pub(crate) struct RecordedMetadata {
+    generation: u32,
+    command_buffer: u64,
+    encoder: u64,
+    pipeline: u64,
+    vulkan_pipeline: vk::Pipeline,
+}
+
+impl Work {
+    pub(crate) fn map(self, raw: vk::CommandBuffer, kind: u64) {
+        self.trace.emit(
+            raw,
+            1,
+            0,
+            [self.command_buffer, self.encoder, self.queue, kind],
+        );
+    }
+
+    pub(crate) fn end(self, raw: vk::CommandBuffer, kind: u64) {
+        self.trace.emit(
+            raw,
+            7,
+            0,
+            [self.command_buffer, self.encoder, kind, 0],
+        );
+    }
+
+    pub(crate) fn pass(self, raw: vk::CommandBuffer, layout: &PassLayout, final_actions: bool) {
+        if !self.trace.enabled() {
+            return;
+        }
+
+        self.trace.emit(
+            raw,
+            2,
+            u32::from(final_actions),
+            [
+                self.encoder,
+                pair(layout.extent[0].into(), layout.extent[1].into()),
+                pair(layout.layers.into(), layout.samples.into()),
+                layout.colors.iter().flatten().count() as u64
+                    + u64::from(layout.depth_stencil.is_some()),
+            ],
+        );
+
+        let attachment_flags = u32::from(final_actions) << 15;
+        for (index, color) in layout.colors.iter().enumerate() {
+            if let Some(color) = color {
+                self.attachment(
+                    raw,
+                    attachment_flags | index as u32,
+                    &color.target,
+                    color.load.raw(),
+                    color.store.raw(),
+                );
+            }
+        }
+
+        if let Some(target) = &layout.depth_stencil {
+            if let Some(depth) = &target.depth {
+                self.attachment(raw, attachment_flags | 0x100, &target.target, depth.load.raw(), depth.store.raw());
+            }
+
+            if let Some(stencil) = &target.stencil {
+                self.attachment(raw, attachment_flags | 0x200, &target.target, stencil.load.raw(), stencil.store.raw());
+            }
+        }
+    }
+
+    fn attachment(
+        self,
+        raw: vk::CommandBuffer,
+        slot: u32,
+        target: &Target,
+        load: u64,
+        store: u64,
+    ) {
+        self.trace.emit(
+            raw,
+            3,
+            slot,
+            [
+                self.encoder,
+                target.texture.object_id().get(),
+                pair(target.extent[0].into(), target.extent[1].into()),
+                u64::from(target.texture.pixel_format().as_raw()) | (load << 32) | (store << 40),
+            ],
+        );
+    }
+
+    pub(crate) fn textures(
+        self,
+        raw: vk::CommandBuffer,
+        stage: u32,
+        first: u32,
+        textures: &[Option<&Texture>],
+    ) {
+        if !self.trace.enabled() {
+            return;
+        }
+
+        for (index, texture) in (first..).zip(textures) {
+            let words = match texture {
+                Some(texture) => [
+                    self.encoder,
+                    texture.object_id().get(),
+                    pair(texture.width(), texture.height()),
+                    pair(u64::from(texture.pixel_format().as_raw()), texture.depth()),
+                ],
+                None => [self.encoder, 0, 0, 0],
+            };
+            self.trace.emit(raw, 4, stage | (index << 8), words);
+        }
+    }
+
+    pub(crate) fn draw(
+        self,
+        raw: vk::CommandBuffer,
+        pipeline: vk::Pipeline,
+        draw: metal2vulkan::vk::DrawCommand,
+        recorded: &mut RecordedMetadata,
+    ) {
+        let generation = self.trace.generation();
+        if generation == 0 {
+            return;
+        }
+
+        use metal2vulkan::vk::DrawCommand;
+        let (kind, count, instances) = match draw {
+            DrawCommand::Draw {
+                vertex_count,
+                instance_count,
+                ..
+            } => (1, vertex_count.into(), instance_count.into()),
+            DrawCommand::DrawIndexed {
+                index_count,
+                instance_count,
+                ..
+            } => (2, index_count.into(), instance_count.into()),
+            DrawCommand::DrawIndirect { draw_count, .. } => {
+                (3, draw_count.into(), 0)
+            }
+            DrawCommand::DrawIndexedIndirect { draw_count, .. } => {
+                (4, draw_count.into(), 0)
+            }
+            DrawCommand::DrawMeshTasks {
+                group_count_x,
+                group_count_y,
+                group_count_z,
+            } => (
+                5,
+                pair(group_count_x.into(), group_count_y.into()),
+                group_count_z.into(),
+            ),
+            DrawCommand::DrawMeshTasksIndirect { draw_count, .. } => {
+                (6, draw_count.into(), 0)
+            }
+            DrawCommand::DrawMeshTasksIndirectCount { max_draw_count, .. } => {
+                (7, max_draw_count.into(), 0)
+            }
+        };
+
+        if recorded.generation != generation
+            || recorded.command_buffer != self.command_buffer
+            || recorded.encoder != self.encoder
+        {
+            self.map(raw, 1);
+            *recorded = RecordedMetadata {
+                generation,
+                command_buffer: self.command_buffer,
+                encoder: self.encoder,
+                ..RecordedMetadata::default()
+            };
+        }
+
+        if recorded.pipeline != self.pipeline || recorded.vulkan_pipeline != pipeline {
+            self.trace.emit(
+                raw,
+                5,
+                kind,
+                [self.encoder, self.pipeline, pipeline.as_raw(), kind.into()],
+            );
+            recorded.pipeline = self.pipeline;
+            recorded.vulkan_pipeline = pipeline;
+        }
+
+        self.trace.emit(
+            raw,
+            6,
+            kind,
+            [self.encoder, self.pipeline, count, instances],
+        );
+    }
+}
+
+fn pair(low: u64, high: u64) -> u64 {
+    (low & u32::MAX as u64) | ((high & u32::MAX as u64) << 32)
+}
