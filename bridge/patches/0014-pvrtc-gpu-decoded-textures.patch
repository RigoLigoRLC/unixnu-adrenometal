+// SPDX-License-Identifier: MIT
+
+use super::*;
+use metal2vulkan::metal::PixelFormat;
+use std::collections::BTreeSet;
+
+pub(super) fn opaque(format: PixelFormat) -> bool {
+    use PixelFormat as P;
+    matches!(format, P::PVRTCRGB2BPP | P::PVRTCRGB2BPPSRGB | P::PVRTCRGB4BPP | P::PVRTCRGB4BPPSRGB)
+}
+
+fn two_bits(format: PixelFormat) -> bool {
+    use PixelFormat as P;
+    matches!(format, P::PVRTCRGB2BPP | P::PVRTCRGB2BPPSRGB | P::PVRTCRGBA2BPP | P::PVRTCRGBA2BPPSRGB)
+}
+
+/// PvrtcBand names one output strip and the wrapped block rows it reads.
+/// Every strip spans the mip level's width. One block row on each side supplies
+/// the neighboring endpoints and the interpolated two-bit modulation values.
+struct PvrtcBand {
+    level: u32,
+    layer: u32,
+    width: u32,
+    height: u32,
+    first_y: u32,
+    band_height: u32,
+    across: u32,
+    down: u32,
+    first_row: u32,
+    rows: u32,
+    blocks_bytes: u64,
+    texels_at: u64,
+    texels_bytes: u64,
+}
+
+impl Image {
+    /// The GPU pass decodes each written mip level and layer into the cached
+    /// RGBA8 image. A write changes neighboring texels, including across an edge;
+    /// refreshing the whole affected level preserves those interpolation inputs.
+    pub(super) fn pvrtc_decode_pass(
+        &self,
+        decoded: &Decoded,
+        format: PixelFormat,
+        regions: &[ImageRegion],
+        scratch: PassScratch,
+    ) -> Result<Option<DecodePass>, Error> {
+        let mut subresources = BTreeSet::new();
+        for region in regions {
+            if region.size.contains(&0) {
+                continue;
+            }
+            for layer in region.layer..region.layer + region.layers {
+                subresources.insert((region.level, layer));
+            }
+        }
+        if subresources.is_empty() {
+            return Ok(None);
+        }
+
+        let device = &self.device;
+        let limits = &device.properties().description.limits;
+        let align = limits.min_storage_buffer_offset_alignment.max(16);
+        let most = u64::from(limits.max_storage_buffer_range).min(BAND_BYTES);
+        let two = two_bits(format);
+        let block_width = if two { 8 } else { 4 };
+        let plan = decoded.image.plan();
+        let mut bands = Vec::new();
+        for (level, layer) in subresources {
+            let width = (plan.extent[0] >> level).max(1);
+            let height = (plan.extent[1] >> level).max(1);
+            let across = width.div_ceil(block_width);
+            let down = height.div_ceil(4);
+            let row_bytes = u64::from(across) * 8;
+            let row_pair = u64::from(width) * 16 + row_bytes;
+            let available = most.saturating_sub(row_bytes * 2 + align);
+            let band_rows = (available / row_pair).max(1).min(u64::from(down)) as u32;
+            for first_y in (0..height).step_by((band_rows * 4) as usize) {
+                let band_height = (band_rows * 4).min(height - first_y);
+                let rows = (band_height.div_ceil(4) + 2).min(down);
+                let first_row = (first_y / 4 + down - 1) % down;
+                let blocks_bytes = row_bytes * u64::from(rows);
+                let texels_at = blocks_bytes.div_ceil(align) * align;
+                let texels_bytes = u64::from(width) * u64::from(band_height) * 4;
+                if texels_at + texels_bytes > most + align {
+                    return Err(internal("PVRTC decode strip exceeds its scratch limit"));
+                }
+                bands.push(PvrtcBand { level, layer, width, height, first_y, band_height,
+                    across, down, first_row, rows, blocks_bytes, texels_at, texels_bytes });
+            }
+        }
+
+        let needed = bands.iter().map(|b| b.texels_at + b.texels_bytes).max().unwrap_or(0);
+        let (scratch, raw_scratch, base, bytes) = match scratch {
+            PassScratch::Own => {
+                let own = device.own_buffer(needed, ResourceOptions::private())?;
+                let (raw, base) = own.at(0);
+                (Some(own), raw, base, needed)
+            }
+            PassScratch::Device => {
+                let firsts = &device.shared().textures.first_moves;
+                (None, firsts.decode_scratch(device, most + align)?, 0, 0)
+            }
+        };
+        const SHAPE_BYTES: u64 = 40;
+        let slot = SHAPE_BYTES.div_ceil(align) * align;
+        let shapes = device.write_combined_buffer(bands.len() as u64 * slot)?;
+        let (raw_shapes, shapes_base) = shapes.at(0);
+        if !base.is_multiple_of(align) || !shapes_base.is_multiple_of(align) {
+            return Err(internal("PVRTC decode buffers do not satisfy descriptor alignment"));
+        }
+        let contents = shapes.contents().ok_or_else(|| internal("PVRTC shapes without host memory"))?;
+        for (index, band) in bands.iter().enumerate() {
+            let values = [band.width, band.height, band.first_y, band.band_height,
+                band.across, band.down, band.first_row, band.rows, u32::from(two), u32::from(opaque(format))];
+            for (word, value) in values.into_iter().enumerate() {
+                let bytes = value.to_le_bytes();
+                // SAFETY: every shape has its aligned 40-byte slot in this live buffer.
+                unsafe {
+                    std::ptr::copy_nonoverlapping(bytes.as_ptr(), contents.as_ptr().add(index * slot as usize + word * 4), 4);
+                }
+            }
+        }
+        let kernel = device.owned_kernel(OwnedModule::PvrtcDecode)?;
+        let ranges: Vec<Vec<(vk::Buffer, u64, u64)>> = bands.iter().enumerate().map(|(index, band)| {
+            vec![(raw_shapes, shapes_base + index as u64 * slot, SHAPE_BYTES),
+                (raw_scratch, base, band.blocks_bytes),
+                (raw_scratch, base + band.texels_at, band.texels_bytes)]
+        }).collect();
+        let sets = OwnedSets::write(device, &kernel, &ranges)?;
+        let mut steps = Vec::with_capacity(bands.len());
+        for (band, &set) in bands.iter().zip(&sets.sets) {
+            let carrier_width = (self.plan().extent[0] >> band.level).max(1);
+            let carrier_height = (self.plan().extent[1] >> band.level).max(1);
+            let mut blocks = Vec::with_capacity(2);
+            let mut left = band.rows;
+            let mut row = band.first_row;
+            let mut offset = base;
+            while left != 0 {
+                let rows = left.min(band.down - row);
+                let region = ImageRegion {
+                    aspect: ImageAspectFlags::COLOR,
+                    level: band.level, layer: band.layer, layers: 1,
+                    origin: [0, row * 4, 0],
+                    size: [carrier_width, (rows * 4).min(carrier_height - row * 4), 1],
+                };
+                blocks.push(vk::BufferImageCopy { buffer_offset: offset, ..buffer_image_copy(&region) });
+                offset += u64::from(rows) * u64::from(band.across) * 8;
+                left -= rows;
+                row = 0;
+            }
+            let region = ImageRegion {
+                aspect: ImageAspectFlags::COLOR,
+                level: band.level, layer: band.layer, layers: 1,
+                origin: [0, band.first_y, 0],
+                size: [band.width, band.band_height, 1],
+            };
+            steps.push(Step {
+                blocks,
+                texels: vk::BufferImageCopy { buffer_offset: base + band.texels_at, ..buffer_image_copy(&region) },
+                set,
+                groups: [band.width.div_ceil(8), band.band_height.div_ceil(8), 1],
+            });
+        }
+        device.shared().counts.block_decode_pass();
+        Ok(Some(DecodePass {
+            image: self.raw.get(), twin: decoded.image.raw.get(), scratch: raw_scratch,
+            pipeline: kernel.pipeline, layout: kernel.layout, steps, bytes,
+            held: Held { _scratch: scratch, _shapes: shapes, _sets: sets },
+        }))
+    }
+}
+
+impl Texture {
+    pub(crate) fn pvrtc_sample_format(&self) -> Option<PixelFormat> {
+        let image = view_shadow::truth(self.image().ok()?);
+        let original = image.decoded.as_deref()?.pvrtc?;
+        if super::super::super::image_plan::block_family(original)
+            != super::super::super::image_plan::block_family(self.pixel_format()) {
+            return None;
+        }
+        Some(crate::pvrtc::sampled_format(self.pixel_format()))
+    }
+}
