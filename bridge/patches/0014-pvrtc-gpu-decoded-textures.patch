     let mut files = vec![PathBuf::from("Cargo.toml"), PathBuf::from("build.rs")];
     collect(Path::new("src"), &mut files);
     files.sort();
@@ -29,6 +30,41 @@ fn main() {
     );
 }
 
+fn compile_pvrtc() {
+    use std::process::Command;
+
+    let source = Path::new("src/texture/pvrtc_decode.comp");
+    let output = PathBuf::from(std::env::var_os("OUT_DIR").expect("Cargo OUT_DIR"))
+        .join("pvrtc_decode.spv");
+    println!("cargo:rerun-if-env-changed=M2V_GLSL_COMPILER");
+    println!("cargo:rerun-if-changed={}", source.display());
+
+    let configured = std::env::var_os("M2V_GLSL_COMPILER");
+    let candidates: Vec<PathBuf> = match configured {
+        Some(path) => vec![path.into()],
+        None => ["glslc", "glslangValidator", "glslang", "/opt/homebrew/bin/glslc", "/opt/homebrew/bin/glslangValidator"]
+            .into_iter().map(PathBuf::from).collect(),
+    };
+    for compiler in candidates {
+        let glslang = compiler.file_name().is_some_and(|name| name == "glslangValidator" || name == "glslang");
+        let mut command = Command::new(&compiler);
+        if glslang {
+            command.args(["-V", "--target-env", "vulkan1.2", "-S", "comp"]);
+        } else {
+            command.args(["--target-env=vulkan1.2", "-fshader-stage=compute", "-O"]);
+        }
+        let result = command.arg(source).arg("-o").arg(&output).output();
+        match result {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(error) => panic!("start {}: {error}", compiler.display()),
+            Ok(result) if result.status.success() => return,
+            Ok(result) => panic!("PVRTC shader compilation with {} failed: {}{}", compiler.display(),
+                String::from_utf8_lossy(&result.stdout), String::from_utf8_lossy(&result.stderr)),
+        }
+    }
+    panic!("PVRTC shader compilation requires glslc or glslangValidator; set M2V_GLSL_COMPILER to its host executable");
+}
+
 fn collect(directory: &Path, output: &mut Vec<PathBuf>) {
     let entries = fs::read_dir(directory)
         .unwrap_or_else(|error| panic!("read {}: {error}", directory.display()));
