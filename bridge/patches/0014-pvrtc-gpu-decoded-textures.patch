@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) Imagination Technologies Ltd.
+// The endpoint and modulation rules follow Native_SDK PVRTDecompress.cpp.
+// The accompanying PVRTC-LICENSE.txt preserves its permission notice.
+#version 450
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) readonly buffer Shape {
+    uint width;
+    uint height;
+    uint first_y;
+    uint band_height;
+    uint blocks_across;
+    uint blocks_down;
+    uint first_block_row;
+    uint block_rows;
+    uint two_bits;
+    uint opaque;
+} shape;
+layout(set = 0, binding = 1, std430) readonly buffer Blocks {
+    uint words[];
+} source;
+layout(set = 0, binding = 2, std430) writeonly buffer Texels {
+    uint words[];
+} target;
+
+uint wrap(int value, uint count) {
+    int remainder = value % int(count);
+    return uint(remainder < 0 ? remainder + int(count) : remainder);
+}
+
+uvec2 blockAt(ivec2 block) {
+    uint x = wrap(block.x, shape.blocks_across);
+    uint y = wrap(block.y, shape.blocks_down);
+    uint row = (y + shape.blocks_down - shape.first_block_row) % shape.blocks_down;
+    uint at = (row * shape.blocks_across + x) * 2;
+    return uvec2(source.words[at], source.words[at + 1]);
+}
+
+uvec4 colorA(uint color) {
+    if ((color & 0x8000u) != 0) {
+        return uvec4((color >> 10) & 31u, (color >> 5) & 31u,
+            (color & 30u) | ((color & 30u) >> 4), 15u);
+    }
+    return uvec4(((color & 0xf00u) >> 7) | ((color & 0xf00u) >> 11),
+        ((color & 0xf0u) >> 3) | ((color & 0xf0u) >> 7),
+        ((color & 0xeu) << 1) | ((color & 0xeu) >> 2), (color & 0x7000u) >> 11);
+}
+
+uvec4 colorB(uint color) {
+    if ((color & 0x80000000u) != 0) {
+        return uvec4((color >> 26) & 31u, (color >> 21) & 31u, (color >> 16) & 31u, 15u);
+    }
+    return uvec4(((color & 0xf000000u) >> 23) | ((color & 0xf000000u) >> 27),
+        ((color & 0xf00000u) >> 19) | ((color & 0xf00000u) >> 23),
+        ((color & 0xf0000u) >> 15) | ((color & 0xf0000u) >> 19), (color & 0x70000000u) >> 27);
+}
+
+uvec4 interpolate(uvec4 p, uvec4 q, uvec4 r, uvec4 s, uvec2 position, uint block_width) {
+    uvec4 top = p * (block_width - position.x) + q * position.x;
+    uvec4 bottom = r * (block_width - position.x) + s * position.x;
+    uvec4 sum = top * (4u - position.y) + bottom * position.y;
+    if (shape.two_bits != 0) {
+        return uvec4((sum.rgb >> 7) + (sum.rgb >> 2), (sum.a >> 5) + (sum.a >> 1));
+    }
+    return uvec4((sum.rgb >> 6) + (sum.rgb >> 1), (sum.a >> 4) + sum.a);
+}
+
+uint modeOf(uvec2 block) {
+    if ((block.y & 1u) == 0) {
+        return 0u;
+    }
+    if ((block.x & 1u) == 0) {
+        return 1u;
+    }
+    return (block.x & (1u << 20)) != 0 ? 3u : 2u;
+}
+
+uint weight(uint code) {
+    return code == 0 ? 0u : code == 1 ? 3u : code == 2 ? 5u : 8u;
+}
+
+uint storedWeight(ivec2 position) {
+    uint x = wrap(position.x, shape.blocks_across * 8u);
+    uint y = wrap(position.y, shape.blocks_down * 4u);
+    uvec2 block = blockAt(ivec2(x / 8u, y / 4u));
+    uint local_index = (y % 4u) * 8u + x % 8u;
+    if ((block.y & 1u) == 0) {
+        return ((block.x >> local_index) & 1u) * 8u;
+    }
+    uint bits = block.x;
+    if ((bits & 1u) != 0) {
+        bits = (bits & ~(1u << 20)) | (((bits >> 21) & 1u) << 20);
+    }
+    bits = (bits & ~1u) | ((bits >> 1) & 1u);
+    return weight((bits >> ((local_index / 2u) * 2u)) & 3u);
+}
+
+uint modulation(ivec2 position, uint block_width) {
+    uvec2 block = blockAt(position / ivec2(block_width, 4));
+    if (shape.two_bits == 0) {
+        uint index = uint(position.y % 4) * 4u + uint(position.x % 4);
+        uint code = (block.x >> (index * 2u)) & 3u;
+        if ((block.y & 1u) != 0) {
+            return code == 0 ? 0u : code == 1 ? 4u : code == 2 ? 14u : 8u;
+        }
+        return weight(code);
+    }
+    uint mode = modeOf(block);
+    if (mode == 0 || ((position.x ^ position.y) & 1) == 0) {
+        return storedWeight(position);
+    }
+    uint horizontal = storedWeight(position + ivec2(-1, 0)) + storedWeight(position + ivec2(1, 0));
+    uint vertical = storedWeight(position + ivec2(0, -1)) + storedWeight(position + ivec2(0, 1));
+    if (mode == 1) {
+        return (horizontal + vertical + 2u) / 4u;
+    }
+    return ((mode == 2 ? horizontal : vertical) + 1u) / 2u;
+}
+
+void main() {
+    uvec2 output_position = gl_GlobalInvocationID.xy;
+    if (output_position.x >= shape.width || output_position.y >= shape.band_height) {
+        return;
+    }
+    uvec2 pixel = uvec2(output_position.x, shape.first_y + output_position.y);
+    uint block_width = shape.two_bits != 0 ? 8u : 4u;
+    uvec2 shifted = pixel + uvec2(block_width / 2u, 2u);
+    ivec2 first = ivec2(shifted / uvec2(block_width, 4u)) - ivec2(1);
+    uvec2 local = shifted % uvec2(block_width, 4u);
+    uvec2 p = blockAt(first);
+    uvec2 q = blockAt(first + ivec2(1, 0));
+    uvec2 r = blockAt(first + ivec2(0, 1));
+    uvec2 s = blockAt(first + ivec2(1, 1));
+    uvec4 a = interpolate(colorA(p.y), colorA(q.y), colorA(r.y), colorA(s.y), local, block_width);
+    uvec4 b = interpolate(colorB(p.y), colorB(q.y), colorB(r.y), colorB(s.y), local, block_width);
+    uint mod = modulation(ivec2(pixel), block_width);
+    bool punch = mod > 10u;
+    if (punch) {
+        mod -= 10u;
+    }
+    uvec4 rgba = (a * (8u - mod) + b * mod) / 8u;
+    if (punch) {
+        rgba.a = 0u;
+    }
+    if (shape.opaque != 0) {
+        rgba.a = 255u;
+    }
+    target.words[output_position.y * shape.width + output_position.x] =
+        rgba.r | (rgba.g << 8) | (rgba.b << 16) | (rgba.a << 24);
+}
