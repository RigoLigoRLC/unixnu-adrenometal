+/// The Vulkan stages that execute Metal render stages, including generated copies and dispatches.
+fn render_stages(stages: RenderStages) -> vk::PipelineStageFlags2 {
+    let mut result = vk::PipelineStageFlags2::ALL_TRANSFER | vk::PipelineStageFlags2::COMPUTE_SHADER;
+    if stages.contains(RenderStages::VERTEX) {
+        result |= vk::PipelineStageFlags2::DRAW_INDIRECT
+            | vk::PipelineStageFlags2::VERTEX_INPUT
+            | vk::PipelineStageFlags2::VERTEX_SHADER;
+    }
+    if stages.intersects(RenderStages::FRAGMENT.union(RenderStages::TILE)) {
+        result |= vk::PipelineStageFlags2::FRAGMENT_SHADER | super::render_target::ATTACHMENT_STAGES;
+    }
+    if stages.contains(RenderStages::OBJECT) {
+        result |= vk::PipelineStageFlags2::DRAW_INDIRECT;
+    }
+    if stages.contains(RenderStages::MESH) {
+        result |= vk::PipelineStageFlags2::DRAW_INDIRECT | vk::PipelineStageFlags2::VERTEX_SHADER;
+    }
+    result
+}
+
+fn render_barrier(after: RenderStages, before: RenderStages) -> Barrier {
+    // A split stores the attachments and loads them in the next instance as well.
+    let attachments = super::render_target::ATTACHMENT_STAGES;
+    Barrier {
+        src: Access::new(render_stages(after) | attachments, vk::AccessFlags2::MEMORY_WRITE),
+        dst: Access::new(render_stages(before) | attachments, vk::AccessFlags2::MEMORY_READ | vk::AccessFlags2::MEMORY_WRITE),
+    }
+}
