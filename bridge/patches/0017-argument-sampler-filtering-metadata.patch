+/// The sampler descriptor contains sorted lookup entries followed by matching metadata records.
+/// Deduplication keeps the lowest heap element for each resource ID. Both arrays receive the
+/// same leading null entries, so a lookup's entry index selects its own bounds and anisotropy.
+fn sampler_table_of(
+    t: &PlannedHandleTable,
+    mut entries: Vec<(u64, u32, u32, u32, u32)>,
+) -> Result<crate::bind::instantiate::DescriptorBytes, BindError> {
+    entries.sort_unstable();
+    entries.dedup_by_key(|e| e.0);
+    let len = t.entries as usize;
+    if entries.len() >= len {
+        return Err(internal("a sampler table over its planned length"));
+    }
+    let null_count = len - entries.len();
+    let mut bytes = Vec::with_capacity(len * SAMPLER_TABLE_BYTES_PER_ENTRY as usize);
+    let null = handle_entry(0, NEUTRAL_ELEMENT, 0);
+    for _ in 0..null_count {
+        bytes.extend_from_slice(&null);
+    }
+    for &(id, element, word, _, _) in &entries {
+        bytes.extend_from_slice(&handle_entry(id, element, word));
+    }
+    for _ in 0..null_count {
+        bytes.extend_from_slice(&null);
+    }
+    for &(_, _, _, bounds, anisotropy) in &entries {
+        bytes.extend_from_slice(&handle_entry(0, bounds, anisotropy));
+    }
+    Ok(crate::bind::instantiate::DescriptorBytes {
+        set: t.set,
+        binding: t.binding,
+        bytes,
+    })
+}
