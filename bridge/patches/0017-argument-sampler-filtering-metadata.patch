+++ b/crates/metal2vulkan/src/lower/sampler/heap_metadata.rs
@@ -0,0 +1,59 @@
+//! Sampler state read through an argument-buffer handle's entry in the sampler table.
+//!
+//! The lookup array keeps its 16-byte entries. Its equally sized trailing array holds each
+//! entry's mip clamps and anisotropy. The binder writes both arrays at encoding and refreshes
+//! both when it lists live sampler states at commit. The shader uses the lookup result's entry
+//! index, including entry zero for a missing handle, to read the corresponding metadata.
+
+use crate::air::ir::ValueId;
+use crate::lower::emit::EmitCx;
+use crate::memory::handles::{
+    EntryField, SAMPLER_METADATA_LEVEL_BITS, entry_field, sampler_metadata_index,
+};
+use crate::spirv::builder::FunctionBuilder;
+use crate::spirv::error::BResult;
+use crate::spirv::ids::Value as SValue;
+use crate::spirv::ir::BinOp;
+
+/// Metadata contains the sampler's state word and the numeric parameters of shader filtering.
+pub(super) struct Metadata {
+    /// SamplerWord contains filtering, addressing, coordinates and comparison fields.
+    pub word: SValue,
+    /// The minimum mip bound in units of 1/64, after the sampler's mip-selection rule.
+    pub min_level: SValue,
+    /// The maximum mip bound in units of 1/64, after the sampler's mip-selection rule.
+    pub max_level: SValue,
+    /// The base-two logarithm of the anisotropy degree: zero is isotropic.
+    pub anisotropy: SValue,
+}
+
+/// The estimate covers three table loads, the metadata index, and both packed-clamp fields.
+pub(super) const WORDS: u32 = 192;
+
+/// The sampler handle is the table entry index emitted by the argument-buffer ID lookup.
+pub(super) fn read(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    handle: ValueId,
+) -> BResult<Metadata> {
+    let Some(table) = cx.decl.families.access.sampler_table else {
+        return Err(cx.fail("an argument-buffer sampler without its metadata table"));
+    };
+    let entry = cx.operand(fb, handle)?;
+    let word = entry_field(fb, table.table, entry, EntryField::Flags)?;
+    let metadata = sampler_metadata_index(fb, table.table, entry)?;
+    let bounds = entry_field(fb, table.table, metadata, EntryField::Element)?;
+    let anisotropy = entry_field(fb, table.table, metadata, EntryField::Flags)?;
+    let mask = fb.u32_const((1 << SAMPLER_METADATA_LEVEL_BITS) - 1)?;
+    let mask = fb.module().const_value(mask)?;
+    let shift = fb.u32_const(SAMPLER_METADATA_LEVEL_BITS)?;
+    let shift = fb.module().const_value(shift)?;
+    let min_level = fb.binary(BinOp::BitwiseAnd, bounds, mask)?;
+    let max_level = fb.binary(BinOp::ShiftRightLogical, bounds, shift)?;
+    Ok(Metadata {
+        word,
+        min_level,
+        max_level,
+        anisotropy,
+    })
+}
