+    let mut writes = crate::tracker::Access::NONE;
+    let (mut host, mut private) = (0, 0);
+    for used in uses.iter().filter(|used| !used.write.is_empty()) {
+        if used.key.host_accessible() {
+            writes = writes.union(used.write);
