+/// The stages that execute a render operation and the copies or dispatches generated for it.
+fn render_stages(stages: RenderStages) -> vk::PipelineStageFlags2 {
+    let mut result =
+        vk::PipelineStageFlags2::ALL_TRANSFER | vk::PipelineStageFlags2::COMPUTE_SHADER;
+    if stages.contains(RenderStages::VERTEX) {
+        result |= VERTEX_DRAW_STAGES;
+    }
+    if stages.intersects(RenderStages::FRAGMENT | RenderStages::TILE) {
+        result |= FRAGMENT_DRAW_STAGES;
+    }
+    if stages.contains(RenderStages::OBJECT) {
+        result |= vk::PipelineStageFlags2::DRAW_INDIRECT | vk::PipelineStageFlags2::TASK_SHADER_EXT;
+    }
+    if stages.contains(RenderStages::MESH) {
+        result |= vk::PipelineStageFlags2::DRAW_INDIRECT | vk::PipelineStageFlags2::MESH_SHADER_EXT;
+    }
+    result
+}
