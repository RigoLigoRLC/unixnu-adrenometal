+/// The explicit render dependency, including attachment stores and loads around the split.
+fn render_barrier(after: RenderStages, before: RenderStages) -> Barrier {
+    let attachments = super::render_target::ATTACHMENT_STAGES;
+    Barrier {
+        src: Access::new(
+            render_stages(after) | attachments,
+            vk::AccessFlags2::MEMORY_WRITE,
+        ),
+        dst: Access::new(
+            render_stages(before) | attachments,
+            vk::AccessFlags2::MEMORY_READ | vk::AccessFlags2::MEMORY_WRITE,
+        ),
+    }
+}
