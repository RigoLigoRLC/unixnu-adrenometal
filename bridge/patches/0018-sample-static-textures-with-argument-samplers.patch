+/// The inline linear filter reads an argument sampler in the function that
+/// owns its handle. Its taps use the non-comparison sampled view; cube taps
+/// continue to use the texture slot's face-array view.
+fn emulation_inline(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+    s: &Sampling,
+    (plane, dref): (SValue, Option<SValue>),
+    spec: ConstId,
+    half: bool,
+) -> BResult<SValue> {
+    let Some(l) = s.linear.as_ref() else {
+        return Err(cx.fail("an inline linear sample without its filter plan"));
+    };
+    let t = Tys::new(fb)?;
+    let at = At::of(cx, fb, s)?;
+    let word = state_word(cx, fb, l)?;
+    let bits = Bits::Spec(spec);
+
+    if let Some(face) = l.cube {
+        return cube::emulate(
+            cx,
+            fb,
+            &t,
+            at.layer,
+            (l, word),
+            (face, plane),
+            (bits, half, dref),
+        );
+    }
+
+    let Source::SlotHeapSampler {
+        texture,
+        sampler,
+        key,
+        ..
+    } = s.source
+    else {
+        return Err(cx.fail("an inline linear filter without an argument sampler"));
+    };
+    let taps = Source::SlotHeapSampler {
+        texture,
+        sampler,
+        key: super::SlotHeapSamplerKey {
+            compare: false,
+            ..key
+        },
+        raw: l.raw,
+    };
+    let (si, image, _) = super::emit::sampled_image(cx, fb, taps)?;
+
+    emulate(cx, fb, &t, &at, (si, image), (l, word), (bits, half, dref))
+}
