+/// ShadowMetadata keeps the texture identity and the allocation's recorded refusal.
+/// Each capture receives that description when a copy first uses the object.
+/// Copy records join the driver's existing GPU timestamps by their operation ID.
+#[derive(Default)]
+pub(crate) struct ShadowMetadata {
+    identity: OnceLock<ShadowIdentity>,
+    reason: OnceLock<ShadowReason>,
+    generation: AtomicU32,
+}
+
+impl ShadowMetadata {
+    pub(crate) fn name(&self, texture: u64, image: vk::Image, texel_bytes: u64, row_pitch: u64) {
+        let _ = self.identity.set(ShadowIdentity {
+            texture,
+            image,
+            texel_bytes,
+            row_pitch,
+        });
+    }
+
+    pub(crate) fn refused(&self, code: u64, text: String) {
+        let _ = self.reason.set(ShadowReason { code, text });
+    }
+
+    pub(crate) fn scope(
+        &self,
+        trace: Option<Trace>,
+        command_buffer: vk::CommandBuffer,
+        buffer: vk::Buffer,
+        cause: u32,
+    ) -> CopyScope {
+        let Some(trace) = trace.filter(|trace| trace.enabled()) else {
+            return CopyScope {
+                previous: CopyContext::default(),
+                active: false,
+            };
+        };
+        let generation = trace.generation();
+        if generation != 0 && self.generation.swap(generation, Ordering::Relaxed) != generation {
+            if let Some(identity) = self.identity.get() {
+                let code = self.reason.get().map_or(0, |reason| reason.code);
+                trace.emit(command_buffer, 12, 1, [
+                    identity.texture, identity.image.as_raw(), buffer.as_raw(), code,
+                ]);
+                trace.emit(command_buffer, 13, 0, [
+                    identity.image.as_raw(), identity.row_pitch, 0, 0,
+                ]);
+                if let Some(reason) = self.reason.get() {
+                    for (index, chunk) in reason.text.as_bytes().chunks(16).take(16).enumerate() {
+                        let mut bytes = [0u8; 16];
+                        bytes[..chunk.len()].copy_from_slice(chunk);
+                        let mut low = [0u8; 8];
+                        let mut high = [0u8; 8];
+                        low.copy_from_slice(&bytes[..8]);
+                        high.copy_from_slice(&bytes[8..]);
+                        trace.emit(command_buffer, 14, 0, [
+                            identity.image.as_raw(),
+                            pair((index * 16) as u64, reason.text.len() as u64),
+                            u64::from_le_bytes(low), u64::from_le_bytes(high),
+                        ]);
+                    }
+                }
+            }
+        }
+        let current = CopyContext {
+            cause,
+            texel_bytes: self.identity.get().map_or(0, |identity| identity.texel_bytes),
+            image: self.identity.get().map_or(vk::Image::null(), |identity| identity.image),
+            shadow: true,
+        };
+        CopyScope {
+            previous: COPY_CONTEXT.with(|context| context.replace(current)),
+            active: true,
+        }
+    }
+}
