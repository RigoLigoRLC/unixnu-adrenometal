+/// CopyScope carries the current shadow operation through its synchronous copy helpers.
+/// The saved scalar context is restored when recording leaves that operation.
+pub(crate) struct CopyScope {
+    previous: CopyContext,
+    active: bool,
+}
+
+impl Drop for CopyScope {
+    fn drop(&mut self) {
+        if self.active {
+            COPY_CONTEXT.with(|context| context.set(self.previous));
+        }
+    }
