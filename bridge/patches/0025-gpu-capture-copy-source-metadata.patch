+pub(crate) fn shadow_refusal(cause: &crate::in_place::ShadowCause) -> u64 {
+    use crate::in_place::{Refusal, ShadowCause};
+    match cause {
+        ShadowCause::Exact => 1,
+        ShadowCause::RenderTarget => 2,
+        ShadowCause::ShaderWrite => 3,
+        ShadowCause::CheckPending(_) => 4,
+        ShadowCause::CheckFailed(_) => 5,
+        ShadowCause::Unchecked(_) => 6,
+        ShadowCause::Refused(refusal, _) => match refusal {
+            Refusal::Rows => 7,
+            Refusal::Detached => 8,
+            Refusal::Image => 9,
+            Refusal::Pitch => 10,
+            Refusal::Placement => 11,
+            Refusal::Source => 12,
+            Refusal::DmaBuf => 13,
+        },
+    }
+}
