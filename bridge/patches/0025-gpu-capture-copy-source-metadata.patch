+    /// Copy metadata describes the command about to be recorded. The driver
+    /// associates its operation ID with the existing GPU interval for that copy.
+    pub(crate) fn copy_buffer_to_image(
+        self,
+        command_buffer: vk::CommandBuffer,
+        source: vk::Buffer,
+        destination: vk::Image,
+        regions: &[vk::BufferImageCopy],
+        location: &'static Location<'static>,
+    ) {
+        if !self.enabled() {
+            return;
+        }
+        let context = COPY_CONTEXT.with(Cell::get);
+        let path = location.file();
+        let origin = if context.shadow {
+            1
+        } else if path.ends_with("/blit_texture.rs") {
+            2
+        } else if path.ends_with("/texture.rs") || path.ends_with("/texture/staging_copy.rs") {
+            3
+        } else if path.ends_with("/texture/first_move.rs") {
+            4
+        } else {
+            5
+        };
+        let copy = COPY_ID.fetch_add(1, Ordering::Relaxed);
+        for (index, region) in regions.iter().take(COPY_REGIONS).enumerate() {
+            let flags = index as u32;
+            self.emit(command_buffer, 9, flags, [
+                copy, region.buffer_offset,
+                pair(region.buffer_row_length.into(), region.buffer_image_height.into()),
+                pair(region.image_extent.width.into(), region.image_extent.height.into()),
+            ]);
+            self.emit(command_buffer, 10, flags, [
+                copy,
+                pair(region.image_subresource.aspect_mask.as_raw().into(), region.image_subresource.mip_level.into()),
+                pair(region.image_subresource.base_array_layer.into(), region.image_subresource.layer_count.into()),
+                pair(region.image_extent.depth.into(), region.image_offset.z as u32 as u64),
+            ]);
+            let row_texels = if region.buffer_row_length == 0 {
+                region.image_extent.width
+            } else {
+                region.buffer_row_length
+            };
+            self.emit(command_buffer, 11, flags, [
+                copy,
+                pair(region.image_offset.x as u32 as u64, region.image_offset.y as u32 as u64),
+                if destination == context.image {
+                    u64::from(row_texels).saturating_mul(context.texel_bytes)
+                } else {
+                    0
+                },
+                pair(origin.into(), location.line().into()),
+            ]);
+        }
+        let truncated = u32::from(regions.len() > COPY_REGIONS) << 15;
+        self.emit(command_buffer, 8, origin | (context.cause << 8) | truncated, [
+            copy, source.as_raw(), destination.as_raw(), regions.len() as u64,
+        ]);
