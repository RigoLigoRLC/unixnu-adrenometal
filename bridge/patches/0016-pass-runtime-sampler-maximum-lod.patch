+/// The upper mip bound from `desc`, in sixty-fourths, with the same grid and
+/// nearest-level rule used by the sampler. Values past every texture's last mip
+/// are capped at `LAST_WORD_LEVEL` before becoming a specialization constant.
+pub(crate) fn query_max_level(desc: &SamplerDescriptor) -> u32 {
+    match desc.mip_filter {
+        SamplerMipFilter::NotMipmapped => 0,
+        SamplerMipFilter::Nearest => nearest_level(desc.lod_max_clamp) * 64,
+        SamplerMipFilter::Linear => {
+            let level = level_on_grid(desc.lod_max_clamp);
+            (level.min(LAST_WORD_LEVEL as f32) * 64.0) as u32
+        }
+    }
+}
