+    fn host_import_release(&self) -> Option<
+        unsafe extern "system" fn(vk::Device, vk::DeviceMemory) -> vk::Result,
+    > {
+        let instance = &self.shared().instance;
+        // The loader owns this private entrypoint for as long as the device lives.
+        let entry = unsafe {
+            instance.entry.get_instance_proc_addr(
+                instance.raw.handle(),
+                c"vkReleaseHostMemoryUNIXNU".as_ptr(),
+            )
+        }?;
+        Some(unsafe { std::mem::transmute(entry) })
+    }
+
+    pub(super) fn confirms_host_import_release(&self) -> bool {
+        cfg!(target_os = "ios") || self.host_import_release().is_some()
+    }
+
+    /// The kernel acknowledgement ends the import's GPU mapping and cache
+    /// maintenance before the caller may free or reuse its host allocation.
+    pub(super) fn release_host_import(&self, memory: vk::DeviceMemory) -> Result<(), vk::Result> {
+        let result = match self.host_import_release() {
+            Some(release) => unsafe { release(self.shared().vk().handle(), memory) },
+            None if cfg!(target_os = "ios") => vk::Result::ERROR_FEATURE_NOT_PRESENT,
+            None => vk::Result::SUCCESS,
+        };
+        if result == vk::Result::SUCCESS {
+            return Ok(());
+        }
+
+        self.mark_lost();
+        Err(result)
+    }
